# Скопируйте в .env и при необходимости поменяйте значения.
# Все переменные имеют дефолты в docker-compose.yml — для локального запуска
# можно вообще обойтись без .env, но для боевого окружения смените секреты.

# Postgres
POSTGRES_USER=laba
POSTGRES_PASSWORD=laba
POSTGRES_DB=laba

# JWT — обязательно сгенерировать длинные случайные секреты для прода
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL_DAYS=30

# Приглашения
INVITE_TTL_DAYS=7

# Публичный адрес фронтенда — на него ведут ссылки-приглашения из писем
APP_URL=http://localhost:3001

# Публичный адрес бэкенда — на него ходит браузер пользователя
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# MinIO (объектное хранилище фотографий)
MINIO_ROOT_USER=labadmin
MINIO_ROOT_PASSWORD=labadmin123
S3_BUCKET=lab-photos
S3_REGION=us-east-1
# Адрес MinIO, по которому ходит БРАУЗЕР пользователя: именно им подписываются
# presigned-ссылки. В проде — публичный домен хранилища.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Время жизни presigned-ссылки на загрузку/скачивание фото, секунды
S3_PRESIGN_TTL_SECONDS=300
