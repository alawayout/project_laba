# Публичный адрес API — доступен из браузера (инлайнится в клиентский бандл при сборке).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Адрес API для серверного кода Next.js (middleware, серверные компоненты).
# Вне докера совпадает с публичным; внутри docker-compose переопределяется на http://backend:3000/api.
BACKEND_INTERNAL_URL=http://localhost:3000/api
