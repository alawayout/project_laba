# Postgres (при запуске через docker-compose из корня backend используйте host=postgres)
DATABASE_URL="postgresql://laba:laba@localhost:5432/laba?schema=public"

PORT=3000
NODE_ENV=development

# JWT — обязательно сгенерировать длинные случайные секреты для прода
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_TTL_DAYS="30"

# Приглашения
INVITE_TTL_DAYS="7"
APP_URL="http://localhost:3001"

# Postgres для docker-compose
POSTGRES_USER="laba"
POSTGRES_PASSWORD="laba"
POSTGRES_DB="laba"

# MinIO / S3-совместимое хранилище фотографий.
# При локальном запуске без docker-compose оба адреса совпадают.
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BUCKET="lab-photos"
S3_REGION="us-east-1"
S3_ACCESS_KEY="labadmin"
S3_SECRET_KEY="labadmin123"
S3_FORCE_PATH_STYLE="true"
S3_PRESIGN_TTL_SECONDS="300"
