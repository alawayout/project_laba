// Точка входа схемы: только generator и datasource.
// Модели разнесены по доменным файлам рядом (auth / tenancy /
// production / inventory) — Prisma склеивает все .prisma в этой папке,
// связи между файлами работают без импортов.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
